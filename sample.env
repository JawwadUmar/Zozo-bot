# LinkedIn Account Credentials
LINKEDIN_EMAIL="youremail@example.com"
LINKEDIN_PASSWORD="your_linkedin_password"
LINKEDIN_JOB_LINK="https://www.linkedin.com/jobs/search/?keywords=software%20engineer&f_TPR=r86400&f_AL=true&sortBy=DD"
PHONE_NUMBER="your_phone_number"

# LLM Provider Configuration ("groq" or "openai")
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-120b"
LLM_TEMPERATURE=0.2

# API Keys (set at least one for your chosen provider)
GROQ_API_KEY="your_groq_api_key"
# OPENAI_API_KEY="your_openai_api_key"

# Optional Model Routing (Cheaper model for observation, stronger model for decision)
# DECISION_LLM_MODEL="gpt-4o"
# OBSERVATION_LLM_MODEL="gpt-4o-mini"

# Agent Safety & Execution Limits
MAX_ACTIONS_PER_APPLICATION=50
MAX_RETRIES=3
HUMAN_APPROVAL_BEFORE_SUBMIT="false"
SCREENSHOT_ON_ERROR="true"

# Hiring Team Auto-Connection Outreach
AUTO_CONNECT_HIRING_TEAM="false"
CONNECTION_NOTE_TEMPLATE="Hi {name}, I applied for the {job_title} role at {company}. I would be glad to connect and follow updates from your hiring team."
